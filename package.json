{
  "name": "fieldmate",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev:ip && docker compose up -d && concurrently --names \"api,app\" --prefix-colors \"cyan,magenta\" --kill-others \"npm:dev:api\" \"npm:dev:app\"",
    "dev:api": "npm run build:shared && npm run dev -w @fieldmate/api",
    "dev:app": "npm run start -w @fieldmate/mobile -- --host lan",
    "dev:web": "npm run start -w @fieldmate/mobile -- --host lan --web",
    "dev:android": "npm run start -w @fieldmate/mobile -- --host lan --android",
    "dev:ios": "npm run start -w @fieldmate/mobile -- --host lan --ios",
    "dev:ip": "node scripts/set-lan-ip.mjs",
    "build:shared": "npm run build -w @fieldmate/shared",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
