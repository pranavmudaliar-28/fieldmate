# FieldMate mobile — local development only. Copy to apps/mobile/.env.
# Only public values belong here: anything prefixed EXPO_PUBLIC_ is bundled into the app.
# Never put secrets in the mobile app.
#
# Staging and production values are set as EAS environment variables
# ("preview" and "production" environments), not in files.

APP_ENV=development

# Android emulator reaches the host machine at 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
