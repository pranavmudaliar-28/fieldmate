# FieldMate API — local development configuration.
# Copy to apps/api/.env (never commit .env). Staging and production values are set
# in the hosting provider's secret manager, never in files.

APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Docker Compose PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgres://fieldmate:fieldmate@localhost:5432/fieldmate_dev

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Comma-separated browser origins allowed by CORS. Leave empty for the mobile app.
CORS_ORIGINS=

# S3-compatible storage. Local development uses MinIO from docker-compose.yml.
# Leave FILE_STORAGE_ENDPOINT empty for AWS S3.
FILE_STORAGE_ENDPOINT=http://localhost:9000
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=fieldmate-dev
FILE_STORAGE_ACCESS_KEY_ID=fieldmate
FILE_STORAGE_SECRET_ACCESS_KEY=fieldmate-dev-secret
FILE_STORAGE_FORCE_PATH_STYLE=true

# Optional: Expo push security access token (https://docs.expo.dev/push-notifications/sending-notifications/)
PUSH_NOTIFICATION_EXPO_ACCESS_TOKEN=
