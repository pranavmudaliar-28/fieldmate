{
  "name": "@fieldmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:int": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --runInBand",
    "db:generate": "tsx --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset-db.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "user:create": "tsx --env-file-if-exists=.env scripts/user-create.ts",
    "user:revoke-sessions": "tsx --env-file-if-exists=.env scripts/user-revoke-sessions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fieldmate/shared": "*",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "expo-server-sdk": "^7.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
